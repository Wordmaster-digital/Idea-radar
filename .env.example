# Copy to .env in this folder. Values stay on this PC; never commit .env.
# Required for Discord delivery. Do not paste the URL into chat.
DISCORD_WEBHOOK_URL=
# Optional: Korean search evidence (App Store search still works without these).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Optional absolute path if codex is not on PATH.
IDEA_CODEX_BIN=
IDEA_MODEL=gpt-5.6-sol
IDEA_LLM_MODE=codex
